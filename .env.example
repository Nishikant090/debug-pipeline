# Copy this file to .env and fill in your values. Never commit .env.

# Groq LLM (required) — https://console.groq.com/keys
GROQ_API_KEY=

# JIRA Cloud (optional — without it, analysis still runs but no tickets are created)
# Base URL is just the site, e.g. https://yourname.atlassian.net
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Project key is the ticket prefix, e.g. KAN for KAN-1
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Owner email notifications (optional, demo_app.py only) — Gmail App Password
SMTP_USERNAME=
SMTP_APP_PASSWORD=
NOTIFY_EMAIL=
